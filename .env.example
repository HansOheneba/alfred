# Copy to .env and fill in real values. Never commit .env.

# From BotFather. Digits, a colon, then the secret.
TELEGRAM_BOT_TOKEN=

# openssl rand -hex 32
# 16–256 characters: letters, numbers, underscore, hyphen.
TELEGRAM_WEBHOOK_SECRET=

DEEPSEEK_API_KEY=

# Verified against https://api.deepseek.com/models on 11 Oct 2026.
# Use deepseek-flash or deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key. In Vercel, store newlines as \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Optional fallback when Supabase is not configured. Linked accounts live in the database.
AUTHORIZED_TELEGRAM_USER_IDS=

APP_TIMEZONE=Africa/Accra
DEFAULT_CURRENCY=GHS

# auto records unambiguous transactions immediately.
# always asks for an inline confirmation first.
CONFIRM_TRANSACTIONS=auto

# Server-only database password. Never prefix this with NEXT_PUBLIC_.
SUPABASE_URL=https://jcenaxceqynywmottkxu.supabase.co
SUPABASE_DB_PASSWORD=

# Browser sign-in. The anon key is public. Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://jcenaxceqynywmottkxu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or the newer publishable key, if that is what the Supabase dashboard shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by npm run seed:users and to create sign-in codes. Keep it on the server.
# Seeded accounts sign in with an email code and can set a password in Settings.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in codes are emailed through Resend. Verify the from address in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Alfred <alfred@example.com>

# Vercel Cron sends this as Authorization: Bearer <value>.
CRON_SECRET=

# The homepage console accepts writes when NODE_ENV is development.
# Set this to true to allow those writes on a deployed server.
STUDIO_ENABLED=
