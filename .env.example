# Copy to .env and fill in real values. Never commit .env.

# From BotFather. Digits, a colon, then the secret.
TELEGRAM_BOT_TOKEN=

# openssl rand -hex 32
# 16–256 characters: letters, numbers, underscore, hyphen.
TELEGRAM_WEBHOOK_SECRET=

# Claude, from console.anthropic.com (API keys). Server-only; every model call uses it.
# Set a monthly spend limit on the workspace in the Console: Alfred has no cap of its own.
ANTHROPIC_API_KEY=
# Optional overrides. Everyday turns, the SMS reader, screenshots and the reply voice
# use ALFRED_MODEL; payment-labelling and other careful turns use ALFRED_STRONG_MODEL.
ALFRED_MODEL=claude-haiku-5-5
ALFRED_STRONG_MODEL=claude-sonnet-5-5

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key. In Vercel, store newlines as \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Who may create an account (sign-up is invite-only; existing accounts can always sign in).
# Comma-separated emails, each with an optional Telegram user ID after a colon that is
# linked to the account on its first sign-in. Unset means nobody new can sign up.
# Example: ALFRED_INVITES=friend@example.com:546068741,other@example.com
ALFRED_INVITES=

# Optional fallback when Supabase is not configured. Linked accounts live in the database.
AUTHORIZED_TELEGRAM_USER_IDS=
# Optional: your own Telegram user ID. Alfred messages you there when the model runs out of credit or its key is rejected.
ALFRED_OPERATOR_TELEGRAM_ID=

APP_TIMEZONE=Africa/Accra
DEFAULT_CURRENCY=GHS

# auto records unambiguous transactions immediately.
# always asks for an inline confirmation first.
CONFIRM_TRANSACTIONS=auto

# Server-only database password. Never prefix this with NEXT_PUBLIC_.
SUPABASE_URL=https://jcenaxceqynywmottkxu.supabase.co
SUPABASE_DB_PASSWORD=

# Browser sign-in. The anon key is public. Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://jcenaxceqynywmottkxu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or the newer publishable key, if that is what the Supabase dashboard shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by npm run seed:users and to create sign-in codes. Keep it on the server.
# Seeded accounts sign in with an email code and can set a password in Settings.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in codes are emailed through Resend. Verify the from address in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Alfred <alfred@example.com>

# Vercel Cron sends this as Authorization: Bearer <value>.
CRON_SECRET=

# Optional browser push. Use Alfred's own keys; never copy another app's credentials.
# Blank values and false gates leave delivery disabled. These do not opt in an account.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
ALFRED_PUSH_DELIVERY_ENABLED=false

# Independent notification recovery/reminders. Configure a real authenticated
# POST /api/notifications/dispatch schedule before filling registration metadata.
# A recent completed dispatcher check-in is also required; metadata alone is not proof.
ALFRED_NOTIFICATION_SCHEDULES_ENABLED=false
ALFRED_NOTIFICATION_CRON_SECRET=
ALFRED_NOTIFICATION_RECOVERY_SCHEDULE_ID=
# Actual registered cadence, an integer from 60 to 300 seconds.
ALFRED_NOTIFICATION_RECOVERY_INTERVAL_SECONDS=

# The homepage console accepts writes when NODE_ENV is development.
# Set this to true to allow those writes on a deployed server.
STUDIO_ENABLED=
