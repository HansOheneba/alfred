# Copy to .env and fill in real values. Never commit .env.

# From BotFather. Digits, a colon, then the secret.
TELEGRAM_BOT_TOKEN=

# openssl rand -hex 32
# 16–256 characters: letters, numbers, underscore, hyphen.
TELEGRAM_WEBHOOK_SECRET=

DEEPSEEK_API_KEY=

# Verified against https://api.deepseek.com/models on 11 Oct 2026.
# Use deepseek-flash or deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key. In Vercel, store newlines as \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Comma-separated numeric Telegram user IDs. Usernames are ignored.
AUTHORIZED_TELEGRAM_USER_IDS=

APP_TIMEZONE=Africa/Accra
DEFAULT_CURRENCY=GHS

# auto records unambiguous transactions immediately.
# always asks for an inline confirmation first.
CONFIRM_TRANSACTIONS=auto

# Server-only. The homepage does not read Supabase from the browser.
SUPABASE_URL=https://jcenaxceqynywmottkxu.supabase.co
SUPABASE_DB_PASSWORD=

# The homepage console accepts writes when NODE_ENV is development.
# Set this to true to allow those writes on a deployed server.
STUDIO_ENABLED=
