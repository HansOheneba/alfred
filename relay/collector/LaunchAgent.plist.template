<plist version="1.0"><dict>
<key>Label</key><string>com.hansopoku.alfred.collector</string>
<key>Disabled</key><true/>
<key>ProgramArguments</key><array><string>__INSTALL_APPROVED_EXECUTABLE_PATH__</string><string>--run</string></array>
