;; Compiled into the relay. Full Disk Access remains a separate macOS decision.
;; Default-deny file contents across disk, with narrow application/runtime access.
;; Validate this profile on each supported macOS version before claiming health.
(version 1)
(allow default)
(deny file-read* file-write* (subpath "/"))

;; Foundation, SQLite, locale/timezone and resolver runtime resources.
(allow file-read*
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (subpath "/usr/share/icu")
  (subpath "/usr/share/zoneinfo")
  (subpath "/private/var/db/timezone")
  (literal "/private/etc/hosts")
  (literal "/private/etc/resolv.conf")
  (literal "/private/etc/localtime")
  (literal "/private/etc/services")
  (literal "/dev/urandom")
  (literal "/dev/random")
  (literal "/dev/null"))

;; Traversal metadata does not grant directory-content reads.
(allow file-read-metadata
  (literal "/") (literal "/Users") (literal "/private")
  (literal "/private/var") (literal "/private/var/db")
  (literal "/private/etc") (literal "/System")
  (literal "/usr") (literal "/usr/share") (literal "/dev")
  (literal (param "HOME"))
  (literal (string-append (param "HOME") "/Library"))
  (literal (string-append (param "HOME") "/Library/Messages"))
  (literal (string-append (param "HOME") "/Library/Application Support")))

;; Messages content is available to relay code, not directory listings.
(allow file-read*
  (literal (string-append (param "HOME") "/Library/Messages/chat.db"))
  (literal (string-append (param "HOME") "/Library/Messages/chat.db-wal"))
  (literal (string-append (param "HOME") "/Library/Messages/chat.db-shm")))
;; SQLite may update its shared-memory index for a read-only WAL connection.
(allow file-write-data
  (literal (string-append (param "HOME") "/Library/Messages/chat.db-shm")))

;; Key, executable, state and logs stay in this single application folder.
(allow file-read*
  (subpath (string-append (param "HOME") "/Library/Application Support/AlfredRelay")))
;; Fixed temporary state path is protected by relay.lock; no broad temp writes.
(allow file-write*
  (literal (string-append (param "HOME") "/Library/Application Support/AlfredRelay/state.json"))
  (literal (string-append (param "HOME") "/Library/Application Support/AlfredRelay/state.json.tmp"))
  (literal (string-append (param "HOME") "/Library/Application Support/AlfredRelay/relay.lock"))
  (literal (string-append (param "HOME") "/Library/Application Support/AlfredRelay/relay.log"))
  (literal "/dev/null"))

(deny process-fork)

;; This confines outbound TCP to port 443, NOT to Alfred's hostname.
;; Application code fixes HTTPS destination and refuses redirects. The macOS
;; resolver socket is allowed; inbound/listening and other ports are denied.
(deny network*)
(allow network-outbound (remote tcp "*:443"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
